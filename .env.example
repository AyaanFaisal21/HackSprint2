# Crash Test — copy to .env, fill what you have, leave the rest blank.
# server.py and crash_test.py both load .env automatically.
# The harness runs LIVE when a model + DAYTONA_API_KEY are set; otherwise it runs in simulation.

# --- Model (pick one) --------------------------------------------------
# A) Amazon Bedrock via the AWS workshop account (recommended: it's already on your screen)
#    Workshop Studio -> left sidebar -> "Get AWS CLI credentials" -> copy the export block, paste it in the terminal,
#    then set these three:
USE_BEDROCK=1
AWS_REGION=us-west-2
# MODEL=            # leave blank to use the default Bedrock Sonnet id set in crash_test.py
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# B) Direct Anthropic API (console.anthropic.com -> API keys). Unset USE_BEDROCK if you use this.
# ANTHROPIC_API_KEY=

# --- Daytona (host sponsor; one disposable sandbox per attack) ---------
# https://app.daytona.io -> sign in with GitHub -> API Keys -> create
DAYTONA_API_KEY=

# --- Anchor Browser (the browse tool) ----------------------------------
# https://app.anchorbrowser.io -> API Access. Harness falls back to stub pages without it; attacks still fire.
ANCHOR_API_KEY=

# --- SurrealDB Agent Memory (attack log + poisoning target) ------------
# https://surrealdb.com/docs/agent-memory/quickstarts/hosted
# Studio -> organisation -> Contexts -> Create context -> API keys. Falls back to a local JSON memory store without it.
SPECTRON_URL=
SPECTRON_CONTEXT_ID=
SPECTRON_API_KEY=

# --- Arize AX (traces + eval attribute) --------------------------------
# https://app.arize.com -> Space settings -> Space ID and API key. Tracing is simply off without it.
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# --- ElevenLabs (narration for the video, optional) --------------------
# https://elevenlabs.io -> profile -> API keys
ELEVENLABS_API_KEY=

# --- Tuning -----------------------------------------------------------
PARALLEL=4
